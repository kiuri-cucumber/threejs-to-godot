{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kiuri-cucumber/threejs-to-godot/blob/main/examples/04-playable-migration/contract.schema.json",
  "title": "Playable migration fixture v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": 1
    },
    "units": {
      "const": "metres"
    },
    "tickHz": {
      "const": 60
    },
    "speed": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "playerHalfSize": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "spawn": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "floorSize": {
      "type": "array",
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "minItems": 2,
      "maxItems": 2
    },
    "wall": {
      "type": "object",
      "properties": {
        "center": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "size": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "center",
        "size",
        "height"
      ],
      "additionalProperties": false
    },
    "goal": {
      "type": "object",
      "properties": {
        "center": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "halfSize": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "center",
        "halfSize"
      ],
      "additionalProperties": false
    },
    "camera": {
      "type": "object",
      "properties": {
        "position": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "lookAt": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "fov": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 180
        },
        "near": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "far": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "position",
        "lookAt",
        "fov",
        "near",
        "far"
      ],
      "additionalProperties": false
    },
    "replay": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "ticks",
          "move"
        ],
        "properties": {
          "ticks": {
            "type": "integer",
            "minimum": 1
          },
          "move": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "minItems": 2,
            "maxItems": 2
          },
          "restart": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "tick": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "tick"
        ],
        "additionalProperties": false
      }
    },
    "positionTolerance": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "cornerEpsilon": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  },
  "required": [
    "schema",
    "units",
    "tickHz",
    "speed",
    "playerHalfSize",
    "spawn",
    "floorSize",
    "wall",
    "goal",
    "camera",
    "replay",
    "snapshots",
    "positionTolerance",
    "cornerEpsilon"
  ],
  "additionalProperties": false
}
